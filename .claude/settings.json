{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "Read(./README.md)",
      "Read(./docs/**)",
      "Read(./src/**)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(./**/*secret*)",
      "Read(./**/*private*)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(kubectl delete *)",
      "Bash(aws *delete*)",
      "Bash(aws *terminate*)",
      "Bash(mysql *)",
      "Bash(psql *)"
    ]
  }
}
