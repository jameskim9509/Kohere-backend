#!/bin/bash
# dev 호스트 부트스트랩 — docker + EBS 마운트 + 시크릿(.env) + compose 기동.
# docker-compose.yml·Caddyfile은 Terraform이 별도 템플릿(docker-compose.yml.tftpl·Caddyfile.tftpl)으로
#   렌더해 compose_yml·caddyfile 변수로 주입한다. 데이터(mysql/mongo)는 EBS, Redis는 인메모리(EBS 미사용).
set -euo pipefail
exec > >(tee /var/log/devhost-init.log) 2>&1

# 0) 스왑 2GB — t3.small(2GB RAM)에서 app(JVM)+mysql+mongo+redis 동시 기동 시 OOM-kill 완충(ADR-0021).
#    엔진 베이스라인은 compose에서 캡(mongo WiredTiger·mysql buffer pool·app JVM Xmx)하고, 스왑은 버스트를 흡수한다.
#    실패해도 부트는 계속한다(set -e 회피) — 스왑 없이도 앱은 떠야 진단이 가능.
setup_swap() {
  [ -f /swapfile ] && return 0
  fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  grep -q '/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >>/etc/fstab
  echo 'vm.swappiness=10' >/etc/sysctl.d/99-swap.conf
  sysctl -w vm.swappiness=10
}
setup_swap || echo "WARN: 스왑 설정 실패 — 부트 계속(메모리 여유 부족 가능)"

# 1) docker + compose v2 플러그인 (x86_64 — ECR 앱 이미지가 amd64)
dnf install -y docker
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# 2) 데이터 EBS 멱등 마운트 (attach 지연 대비 대기). Redis는 인메모리라 EBS 디렉터리 없음.
ROOT_DISK=$(findmnt -no SOURCE / | sed 's/p\?[0-9]*$//')
DATA_DEV=""
for i in $(seq 1 30); do
  DATA_DEV=$(lsblk -dpno NAME,TYPE | awk '$2=="disk"{print $1}' | grep -v "$ROOT_DISK" | head -1)
  [ -n "$DATA_DEV" ] && break
  sleep 5
done
blkid "$DATA_DEV" >/dev/null 2>&1 || mkfs.xfs "$DATA_DEV"
mkdir -p /data
UUID=$(blkid -s UUID -o value "$DATA_DEV")
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID /data xfs defaults,nofail 0 2" >>/etc/fstab
mountpoint -q /data || mount /data
mkdir -p /data/mysql /data/mongo

# 3) ECR 로그인 + 재로그인 스크립트(CI 배포 시 SSM이 호출 — ECR 토큰 만료 대비)
mkdir -p /opt/kohere
cat >/opt/kohere/ecr-login.sh <<'SH'
aws ecr get-login-password --region ${aws_region} | docker login --username AWS --password-stdin ${account_id}.dkr.ecr.${aws_region}.amazonaws.com
SH
chmod +x /opt/kohere/ecr-login.sh
bash /opt/kohere/ecr-login.sh

# 4) 시크릿 → .env (SSM Parameter Store SecureString, 인스턴스 프로파일. SM 미사용)
#    refresh-env.sh로 분리 — 배포(deploy.yml) 때도 재호출해 Parameter Store 최신값을 .env로 다시 받는다.
mkdir -p /opt/kohere
cat >/opt/kohere/refresh-env.sh <<'REFRESH'
${refresh_env}
REFRESH
chmod +x /opt/kohere/refresh-env.sh
bash /opt/kohere/refresh-env.sh

# 5) Caddyfile · docker-compose.yml + reconcile-db.sh (Terraform이 렌더한 결과 주입)
#    app 컨테이너의 /logs 바인드 마운트 대상(ADR-0038). 호스트에 두어야 CloudWatch Agent가 tail할 수 있고
#    --force-recreate로 컨테이너를 갈아도 로그가 남는다.
mkdir -p /opt/kohere/logs
cat >/opt/kohere/Caddyfile <<'CADDY'
${caddyfile}
CADDY
cat >/opt/kohere/docker-compose.yml <<'COMPOSE'
${compose_yml}
COMPOSE
cat >/opt/kohere/reconcile-db.sh <<'RECONCILE'
${reconcile_db}
RECONCILE
chmod +x /opt/kohere/reconcile-db.sh

# 6) 기동 + DB 자격증명 reconcile(최초엔 마커 시드=no-op, 데이터 보존 회전 — ADR-0025)
#    공용 이미지(mysql/mongo/redis/caddy)는 항상 기동한다. 앱 이미지(ECR :dev)는 첫 CI 배포 전엔 없을 수 있어
#    best-effort로만 시도 — 없어도 인프라·DB는 정상(README §6 대안 B). pull 한 번 실패가 전체를 중단(set -e)시키지 않게 분리.
cd /opt/kohere
docker compose up -d mysql mongo redis caddy
if docker compose pull app 2>/dev/null; then
  docker compose up -d app
else
  echo "WARN: app 이미지(ECR :dev) 없음 — DB·인프라만 기동. CI 배포(release 머지)로 app이 채워진다."
fi
bash /opt/kohere/reconcile-db.sh || true
docker image prune -f # 직전 :dev 이미지(dangling) 즉시 정리 — root 볼륨 보호

# 7) 디스크 보호 타이머 — :dev 이동 태그라 배포마다 이전 이미지가 dangling으로 쌓여 20GB root가 찰 수 있다.
#    배포(deploy.yml)는 recreate 직후 즉시 prune하고, 여기선 안전망으로 미사용 리소스를 매일(7일 이전) 정리한다.
#    빌드는 GitHub Actions에서만 하므로 호스트엔 빌드 캐시가 없다(이미지 누적이 유일한 증가원).
cat >/etc/systemd/system/docker-prune.service <<'UNIT'
[Unit]
Description=Prune unused docker images/containers (dev disk guard)
Requires=docker.service
After=docker.service
[Service]
Type=oneshot
ExecStart=/usr/bin/docker system prune -af --filter until=168h
UNIT
cat >/etc/systemd/system/docker-prune.timer <<'UNIT'
[Unit]
Description=Daily docker prune (dev disk guard)
[Timer]
OnCalendar=daily
Persistent=true
[Install]
WantedBy=timers.target
UNIT
systemctl enable --now docker-prune.timer

# 8) CloudWatch Agent — /opt/kohere/logs/app.json(logback JSON_FILE)을 tail해 Log Group으로 반출(ADR-0038 ⑥).
#    앱은 AWS SDK를 물지 않고 파일까지만 책임진다 — 로그 내용과 전송 경로를 직교로 유지한다.
#
#    ADR-0038의 도입 게이트("여유 300MB 미만이면 보류")는 dev 호스트 실측으로 통과했다 —
#    available 656Mi, 스왑 2Gi 중 29Mi만 사용. 기준은 free가 아니라 available이다(free가 낮은 것은
#    회수 가능한 페이지 캐시 때문). Agent 상주는 ~50-100MB. 압박이 생기면 스왑 사용량이 먼저 오르므로
#    그 값을 지표로 보고, 지속되면 enable_cloudwatch_agent=false 또는 t3.medium으로 되돌린다.
%{ if enable_cloudwatch_agent ~}
dnf install -y amazon-cloudwatch-agent
cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CWAGENT'
${cloudwatch_agent_config}
CWAGENT
# fetch-config가 설정을 적용하고 에이전트를 기동한다(-s). 실패해도 부트는 계속한다 —
# 로그 반출이 안 되는 것보다 앱이 안 뜨는 게 더 나쁘다.
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
  || echo "WARN: CloudWatch Agent 기동 실패 — 앱은 정상, 로그 반출만 중단(SSM으로 진단)"
%{ else ~}
echo "INFO: CloudWatch Agent 비활성(enable_cloudwatch_agent=false). 로그는 /opt/kohere/logs/app.json에만 쌓인다 — ADR-0026 메모리 게이트."
%{ endif ~}
