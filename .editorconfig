root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# 마크다운은 산문/목록 특성상 들여쓰기를 2의 배수로 강제하지 않고,
# 줄 끝 두 칸(hard line break) 표기를 허용한다.
[*.md]
indent_size = unset
trim_trailing_whitespace = false

# Gradle wrapper는 Gradle 배포본 그대로 유지하는 파일이므로 검사하지 않는다.
# (gradlew는 4칸 들여쓰기, gradlew.bat은 CRLF를 사용한다)
[{gradlew,gradlew.bat,gradle/wrapper/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
